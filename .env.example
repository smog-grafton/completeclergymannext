# Laravel public API for local development. Vercel uses the committed
# `.env.production` API origin; override it in Vercel only when promoting a
# different environment.
# Local `php artisan serve --port=8765` default. In XAMPP, use a vhost whose
# document root is clergyman-lara/public rather than exposing the project root.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8765
